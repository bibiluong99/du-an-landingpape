{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{db_fallback_data.json,public/*.html}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.js" },
    { "source": "/robots.txt", "destination": "/api/index.js" },
    { "source": "/sitemap.xml", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/products", "destination": "/api/index.js" },
    { "source": "/product-detail", "destination": "/api/index.js" },
    { "source": "/about", "destination": "/api/index.js" },
    { "source": "/blogs", "destination": "/api/index.js" },
    { "source": "/blog-detail", "destination": "/api/index.js" },
    { "source": "/contact", "destination": "/api/index.js" },
    { "source": "/huong-dan-bao-gia", "destination": "/api/index.js" },
    { "source": "/dieu-khoan-su-dung", "destination": "/api/index.js" },
    { "source": "/chinh-sach-bao-hanh", "destination": "/api/index.js" },
    { "source": "/chinh-sach-bao-mat", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/login.html" }
  ]
}
